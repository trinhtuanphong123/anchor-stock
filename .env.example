# =============================================================================
# Anchor-model system — .env.example
# =============================================================================
# Names actually read by the code as it exists today (verified by grepping os.environ /
# os.getenv across pipelines/ and services/ — see P6.0). The root .env this repo has carried
# since before version control (see docs/00-project-status.md) is a leftover ClusterWeb
# template full of variables nothing here reads (CLUSTERWEB_*, DNSE_API_KEY, VNSTOCK_API_KEY,
# infra/aws/env/* paths); this file replaces it as the actual reference. .env itself stays
# gitignored and is never committed filled in.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (pipelines/common/db.py, services/api)
# ---------------------------------------------------------------------------
# Points at the named local container from scripts/db/compose.db.yml (P6, S1) — bring it up
# with scripts/db/apply_migrations.ps1. Swap for a real Supabase connection string only for
# the separate, explicitly-gated promotion step (P6 S2); never commit that value.
DATABASE_URL=postgresql://datn:datn_local_dev@localhost:55432/datn

# ---------------------------------------------------------------------------
# Local train track storage (pipelines/storage/factory.py, pipelines/common/paths.py)
# ---------------------------------------------------------------------------
# "local" (default) or "pg". Local writes under DATN_DATA_ROOT; pg writes through DATABASE_URL.
DATN_STORAGE=local

# Root for local-track output (raw/, processed/, artifacts/, research/). Defaults to ./data
# under the repo root when unset — set this only to redirect it elsewhere.
# DATN_DATA_ROOT=D:/DATN_new/data

# ---------------------------------------------------------------------------
# services/api runtime guards (services/api/app/runtime_guards.py)
# ---------------------------------------------------------------------------
# development | test | production. Only production enables the fail-fast startup guards.
ENV=development

# Comma-separated CORS origins. Production must be explicit; no localhost default there.
ALLOWED_ORIGINS=http://localhost:3000

# Dev/test fixtures switch. Must be falsy (or unset) whenever ENV=production.
API_DEV_FIXTURES=
